# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Claude on Microsoft Azure (Foundry) ---
ANTHROPIC_FOUNDRY_RESOURCE=
ANTHROPIC_FOUNDRY_API_KEY=
# Deployment name of the Claude model in your Foundry resource
CLAUDE_DEPLOYMENT=

# --- OpenAI model on the same Azure resource (e.g. gpt-4.1-mini). Takes priority if set.
# Reuses the resource + key above unless AZURE_OPENAI_RESOURCE / AZURE_OPENAI_API_KEY are set.
OPENAI_DEPLOYMENT=
# Responses API on its own resource (key from that resource, not the Claude one):
# AZURE_OPENAI_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# OPENAI_REASONING_EFFORT=low   # only if the model is a reasoning model

# --- Or the direct Anthropic API (used if the Foundry values above are empty) ---
ANTHROPIC_API_KEY=

# --- Pipeline defaults ---
WHISPER_MODEL=medium.en
VOICE_MATCH_THRESHOLD=0.5

# --- LLM spend cap (USD, cumulative; see budget.py) ---
LLM_BUDGET_USD=0.20
LLM_PRICE_IN_PER_M=0.10
LLM_PRICE_OUT_PER_M=0.50

# --- Sharing (share.py) ---
SALESIQ_USER=salesiq
SALESIQ_PASSWORD=
